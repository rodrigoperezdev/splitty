{
  "name": "splitty",
  "version": "0.0.1",
  "private": true,
  "workspaces": ["apps/*"],
  "scripts": {
    "prepare": "husky",
    "dev:frontend": "npm --workspace @splitty/frontend run dev",
    "dev:backend": "npm --workspace @splitty/backend run dev",
    "build:frontend": "npm --workspace @splitty/frontend run build",
    "build:backend": "npm --workspace @splitty/backend run build",
    "build": "npm run build:frontend && npm run build:backend",
    "lint": "npm --workspace @splitty/frontend run lint",
    "format": "prettier --write \"apps/**/*.{js,jsx,ts,tsx,md,css,json}\"",
    "format:check": "prettier --check \"apps/**/*.{js,jsx,ts,tsx,md,css,json}\""
  },
  "devDependencies": {
    "@commitlint/cli": "18.4.4",
    "@commitlint/config-conventional": "18.4.4",
    "autoprefixer": "10.4.19",
    "eslint-config-prettier": "9.1.0",
    "husky": "9.0.11",
    "lint-staged": "15.2.2",
    "postcss": "8.4.34",
    "prettier": "3.2.5"
  },
  "lint-staged": {
    "apps/frontend/**/*.{js,jsx,ts,tsx}": [
      "npm --workspace @splitty/frontend run lint",
      "npm --workspace @splitty/frontend run format:check"
    ],
    "apps/frontend/**/*.{css,md,json}": [
      "npm --workspace @splitty/frontend run format:check"
    ]
  }
}
